# ===================================================================
# TaskBoard Environment Configuration
# Copy this file to .env and configure values before starting
# ===================================================================

PORT=3000
NODE_ENV=development
DB_PATH=data/taskboard.db

# -------------------------------------------------------------------
# JWT Security Configuration
# -------------------------------------------------------------------
# CRITICAL: In production, the server will refuse to start if JWT_SECRET
# is missing, shorter than 32 characters, or set to a default/placeholder.
#
# Generate a cryptographically secure 256-bit secret using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or using OpenSSL:
#   openssl rand -hex 32
#
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# -------------------------------------------------------------------
# Network Security & Deployment Settings
# -------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (e.g., https://app.example.com)
# In development, leave blank to permit standard localhost access.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reverse Proxy Trust Configuration:
# Set to 'true' or '1' ONLY if TaskBoard is deployed behind a trusted reverse
# proxy (e.g. Nginx, Cloudflare, Caddy, AWS ALB) that sets X-Forwarded-For.
# Leaving this false ensures rate limiters cannot be bypassed by IP spoofing.
TRUST_PROXY=false
